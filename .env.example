# ===== Обязательно =====

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAA-your-token-here

# Ключ DeepSeek: https://platform.deepseek.com/api_keys
# Без ключа бот работает только с командами (/remind, /list, /note...), без ИИ.
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ===== Доступ =====

# Ваш Telegram ID (можно несколько через запятую). Узнать: напишите боту /id
# Если оставить пустым — владельцем станет первый, кто напишет боту.
ALLOWED_USER_IDS=

# ===== Время и напоминания =====

# Часовой пояс по умолчанию (можно поменять в боте: /tz)
TIMEZONE=Europe/Moscow
# За сколько минут по умолчанию напоминать о событиях (встречи, пары и т.п.)
DEFAULT_REMIND_BEFORE=15
# Утренняя сводка «план на день»: ЧЧ:ММ или off
DAILY_DIGEST_TIME=08:00

# ===== ИИ =====

# deepseek-chat — быстрая модель с вызовом функций (рекомендуется)
# deepseek-reasoner — «думающая», медленнее
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.7
# Сколько последних сообщений диалога помнить
HISTORY_LIMIT=30

# ===== Прочее =====

# Где хранить данные (напоминания, заметки, история)
DATA_DIR=./data
# Свой адрес Bot API (локальный сервер или прокси), обычно не нужно
# TELEGRAM_API_URL=https://api.telegram.org
# DNS-серверы, если в Termux не работает DNS (по умолчанию определяются сами)
# DNS_SERVERS=1.1.1.1,8.8.8.8
